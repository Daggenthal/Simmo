; Engine configuration file.
config_version=5

[application]

run/max_fps=0

config/name="Simmo"
config/description="M1 prototype: combat, portal maps and a SimPlayer party with placeholder art"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Log="*res://scripts/log.gd"
GameInput="*res://scripts/game_input.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[layer_names]

2d_physics/layer_1="ground"
2d_physics/layer_2="platforms"
2d_physics/layer_3="actors"
